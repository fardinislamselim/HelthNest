
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to HealthNest</title>
</head>

<body style="margin:0; padding:0; background-color:#f1f5f9; font-family:Arial, Helvetica, sans-serif; color:#1e293b;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f1f5f9; padding:40px 15px;">
    <tr>
      <td align="center">

        <!-- Main Container -->
        <table width="600" cellpadding="0" cellspacing="0" border="0"
          style="max-width:600px; width:100%; background:#ffffff; border-radius:16px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#0f766e; padding:35px 25px;">
              <h1 style="margin:0; color:#ffffff; font-size:30px; font-weight:700; letter-spacing:-1px;">
                Health<span style="color:#99f6e4;">Nest</span>
              </h1>
              <p style="margin:10px 0 0; color:#ccfbf1; font-size:13px; letter-spacing:1px;">
                HEALTHCARE MANAGEMENT PLATFORM
              </p>
            </td>
          </tr>

          <!-- Welcome Section -->
          <tr>
            <td style="padding:35px 35px 20px;">
              <p style="margin:0 0 12px; color:#0f766e; font-size:13px; font-weight:bold; text-transform:uppercase; letter-spacing:1px;">
                Welcome Aboard!
              </p>

              <h2 style="margin:0 0 15px; color:#0f172a; font-size:25px; line-height:1.4;">
                Hello, <%= name %>!
              </h2>

              <p style="margin:0; color:#64748b; font-size:15px; line-height:1.8;">
                Your administrator account has been successfully created.
                We're excited to have you on board. You can now access
                HealthNest using the credentials below.
              </p>
            </td>
          </tr>

          <!-- Credentials Card -->
          <tr>
            <td style="padding:15px 35px 25px;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#f0fdfa; border:1px solid #ccfbf1; border-radius:12px;">

                <tr>
                  <td style="padding:22px 22px 10px;">
                    <h3 style="margin:0; color:#115e59; font-size:16px;">
                      Your Login Credentials
                    </h3>
                    <p style="margin:7px 0 0; color:#64748b; font-size:13px;">
                      Keep these details safe and confidential.
                    </p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 22px 8px;">
                    <p style="margin:0 0 7px; color:#64748b; font-size:12px; font-weight:bold; text-transform:uppercase;">
                      Organization Login Email
                    </p>
                    <p style="margin:0; padding:13px 14px; background:#ffffff; border:1px solid #e2e8f0; border-radius:7px; color:#0f172a; font-size:14px; font-weight:bold; word-break:break-word;">
                      <%= organizationEmail %>
                    </p>
                  </td>
                </tr>

                <tr>
                  <td style="padding:12px 22px 22px;">
                    <p style="margin:0 0 7px; color:#64748b; font-size:12px; font-weight:bold; text-transform:uppercase;">
                      Temporary Password
                    </p>
                    <p style="margin:0; padding:13px 14px; background:#ffffff; border:1px solid #e2e8f0; border-radius:7px; color:#0f766e; font-size:15px; font-weight:bold; letter-spacing:1px; word-break:break-word;">
                      <%= password %>
                    </p>
                  </td>
                </tr>

              </table>
            </td>
          </tr>

          <!-- Security Notice -->
          <tr>
            <td style="padding:0 35px 25px;">
              <table width="100%" cellpadding="0" cellspacing="0" border="0"
                style="background-color:#fffbeb; border-left:4px solid #f59e0b; border-radius:6px;">
                <tr>
                  <td style="padding:16px;">
                    <p style="margin:0 0 6px; color:#92400e; font-size:14px; font-weight:bold;">
                      Important Security Notice
                    </p>
                    <p style="margin:0; color:#92400e; font-size:13px; line-height:1.7;">
                      This is a temporary password. Please sign in and change
                      your password immediately to protect your administrator account.
                      Never share your login credentials with anyone.
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer Message -->
          <tr>
            <td align="center" style="padding:10px 35px 30px;">
              <p style="margin:0 0 8px; color:#334155; font-size:15px; font-weight:bold;">
                Welcome to the HealthNest family!
              </p>
              <p style="margin:0; color:#94a3b8; font-size:13px; line-height:1.7;">
                We're here to make healthcare management simpler and smarter.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f8fafc; padding:22px 20px; border-top:1px solid #e2e8f0;">
              <p style="margin:0 0 6px; color:#0f766e; font-size:16px; font-weight:bold;">
                HealthNest
              </p>
              <p style="margin:0 0 10px; color:#94a3b8; font-size:12px;">
                Smart Healthcare Management System
              </p>
              <p style="margin:0; color:#94a3b8; font-size:11px;">
                &copy; <%= new Date().getFullYear() %> HealthNest. All rights reserved.
              </p>
              <p style="margin:8px 0 0; color:#94a3b8; font-size:11px;">
                This is an automated email. Please do not reply.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
