<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HealthNest - Forgot Password</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #1f2937;
    "
  >
    <div style="max-width: 600px; margin: 40px auto; padding: 20px;">
      <div
        style="
          background-color: #ffffff;
          border-radius: 12px;
          overflow: hidden;
          box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        "
      >
        <!-- Header -->
        <div
          style="
            background-color: #0d9488;
            padding: 28px 20px;
            text-align: center;
            color: #ffffff;
          "
        >
          <h1 style="margin: 0; font-size: 28px;">
            HealthNest
          </h1>
          <p style="margin: 8px 0 0; font-size: 14px;">
            Your Health, Our Priority
          </p>
        </div>

        <!-- Email Content -->
        <div style="padding: 35px 30px;">
          <h2
            style="
              margin-top: 0;
              color: #111827;
              font-size: 22px;
            "
          >
            Forgot Your Password?
          </h2>

          <p style="font-size: 15px; line-height: 1.7; color: #4b5563;">
            Hello,
          </p>

          <p style="font-size: 15px; line-height: 1.7; color: #4b5563;">
            We received a request to reset the password associated with your
            HealthNest account. Use the verification code below to continue.
          </p>

          <!-- OTP Code -->
          <div
            style="
              margin: 30px 0;
              padding: 22px;
              background-color: #f0fdfa;
              border: 1px dashed #0d9488;
              border-radius: 8px;
              text-align: center;
            "
          >
            <p
              style="
                margin: 0 0 12px;
                font-size: 13px;
                color: #4b5563;
              "
            >
              Your password reset verification code
            </p>

            <h1
              style="
                margin: 0;
                color: #0d9488;
                font-size: 34px;
                letter-spacing: 8px;
              "
            >
              <%= otp %>
            </h1>

            <p
              style="
                margin: 14px 0 0;
                font-size: 12px;
                color: #6b7280;
              "
            >
              This code expires in <%= expiresIn || "5 minutes" %>.
            </p>
          </div>

          <p style="font-size: 14px; line-height: 1.7; color: #4b5563;">
            Enter this code on HealthNest to verify your request and reset your
            password.
          </p>

          <div
            style="
              margin-top: 25px;
              padding: 15px;
              background-color: #fff7ed;
              border-left: 4px solid #f59e0b;
              border-radius: 4px;
            "
          >
            <p
              style="
                margin: 0;
                font-size: 13px;
                line-height: 1.7;
                color: #92400e;
              "
            >
              <strong>Security Notice:</strong> If you did not request a
              password reset, please ignore this email. Never share this
              verification code with anyone.
            </p>
          </div>

          <p
            style="
              margin-top: 30px;
              font-size: 14px;
              line-height: 1.7;
              color: #4b5563;
            "
          >
            Stay healthy,<br />
            <strong>The HealthNest Team</strong>
          </p>
        </div>

        <!-- Footer -->
        <div
          style="
            padding: 20px;
            background-color: #f9fafb;
            border-top: 1px solid #e5e7eb;
            text-align: center;
          "
        >
          <p style="margin: 0; font-size: 12px; color: #9ca3af;">
            © <%= new Date().getFullYear() %> HealthNest. All rights reserved.
          </p>

          <p
            style="
              margin: 8px 0 0;
              font-size: 12px;
              color: #9ca3af;
            "
          >
            Secure healthcare, simplified.
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
