<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HealthNest - Verify Email</title>
  </head>
  <body style="margin:0;padding:0;background:#f4f7fb;font-family:Arial,sans-serif;color:#1f2937;">
    <div style="max-width:600px;margin:40px auto;padding:20px;">
      <div style="background:#fff;border-radius:12px;overflow:hidden;">
        <div style="background:#0d9488;padding:28px 20px;text-align:center;color:#fff;">
          <h1 style="margin:0;">HealthNest</h1>
          <p>Verify your email address</p>
        </div>
        <div style="padding:35px 30px;">
          <p>Hello <%= name %>,</p>
          <p>Use this code to verify your HealthNest email address:</p>
          <div style="margin:30px 0;padding:22px;background:#f0fdfa;border:1px dashed #0d9488;border-radius:8px;text-align:center;">
            <h1 style="margin:0;color:#0d9488;font-size:34px;letter-spacing:8px;"><%= otp %></h1>
            <p style="font-size:12px;color:#6b7280;">This code expires in <%= expiresIn %>.</p>
          </div>
          <p style="font-size:14px;color:#4b5563;">Never share this code with anyone.</p>
          <p>Stay healthy,<br /><strong>The HealthNest Team</strong></p>
        </div>
      </div>
    </div>
  </body>
</html>
