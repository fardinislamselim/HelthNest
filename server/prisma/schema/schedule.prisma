model Schedule {
  id String @id @default(uuid())

  doctorId String
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  date      String // Format: YYYY-MM-DD
  startTime String // Format: HH:mm
  endTime   String // Format: HH:mm
  meetLink  String

  status     ScheduleStatus @default(DRAFT)
  totalSlots Int            @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots        Slot[]
  appointments Appointment[]

  @@unique([doctorId, date], name: "unique_doctor_schedule_date")
  @@index([doctorId], name: "idx_schedule_doctor")
  @@index([date], name: "idx_schedule_date")
  @@index([status], name: "idx_schedule_status")
  @@map("schedules")
}


